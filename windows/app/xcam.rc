// Windows resources for xcam-app.
//
// The application had no icon at all until this file existed: the title bar,
// the taskbar and Alt-Tab all showed the default blank page, which is what an
// unfinished tool looks like regardless of what it does.
//
// xcam.ico is generated by tools/make-icons.py from the same geometry as
// brand/xcam-mark.svg -- it is checked in because a build must not depend on
// Python being installed.

#include "app/xcam_resource.h"

IDI_XCAM ICON "xcam.ico"
